{
  "name": "pod",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "pod": "./dist/index.js"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/linux-x64",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
